        "drizzle-orm": "^0.36.4",
        "jose": "^5.10.0",
        "next": "^15.1.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zustand": "^5.0.2",
        "zod": "^3.24.1"
