    "devDependencies": {
        "@centwise/config-eslint": "workspace:*",
        "@centwise/config-typescript": "workspace:*",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.10.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.2",
        "postcss": "^8.4.49",
