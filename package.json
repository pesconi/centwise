{
    "name": "centwise",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@9.15.4",
    "engines": {
        "node": ">=20.9.0",
        "pnpm": ">=9.15.0"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev --filter=@centwise/web",
        "dev:web": "turbo run dev --filter=@centwise/web",
        "dev:mobile": "turbo run dev --filter=@centwise/mobile",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "turbo": "^2.3.3",
        "typescript": "6.0.3"
    }
}